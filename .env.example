# Host edge port (bound to 127.0.0.1 only)
EDGE_PORT=8088

# PostgreSQL
POSTGRES_USER=devnet
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=devnet

# Redis (used inside compose; override if pointing elsewhere)
REDIS_URL=redis://redis:6379

# API secrets
JWT_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=false
CORS_ORIGIN=true

# Seeded admin account (created on first API boot)
ADMIN_EMAIL=admin@devnet.local
ADMIN_PASSWORD=AdminPassword123!
ADMIN_USERNAME=admin

# Host Nginx (path-mounted deploy)
PROJECT_NAME=devnet
NGINX_SERVER_NAME=launch.giangnt.dev
